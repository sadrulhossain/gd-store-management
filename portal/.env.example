# Only needed when running the portal outside Docker (`npm run dev` on the host).
# Under Docker Compose these values are injected from the repository-root .env.
# Copy to .env.local (git-ignored) to use.

# Gateway (nginx) as seen from the host: published GATEWAY_PORT.
API_INTERNAL_URL=http://localhost:38080/api/v1
GATEWAY_URL=http://localhost:38080
REFRESH_TOKEN_TTL_DAYS=14
# Cookies are Secure only in production builds unless overridden.
# COOKIE_SECURE=false
