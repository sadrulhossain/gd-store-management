# Rendered by the image entrypoint (envsubst). Variables: UPLOAD_MAX_SIZE,
# API_FASTCGI_UPSTREAM, PORTAL_UPSTREAM.

server {
    listen 8080;
    server_name _;

    root /var/www/html/public;
    client_max_body_size ${UPLOAD_MAX_SIZE};

    # Docker's embedded DNS; upstreams are resolved per request so the gateway
    # starts even when the API or portal container is not up yet.
    resolver 127.0.0.11 valid=10s ipv6=off;

    add_header X-Content-Type-Options "nosniff" always;

    location = /nginx-health {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Uploaded public images: served straight from the shared volume, no symlink.
    location /storage/ {
        alias /var/www/html/storage/app/public/;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Cache-Control "public, max-age=3600";
        try_files $uri =404;

        # Never execute anything from uploads.
        location ~* \.(php|phtml|phar)$ {
            return 403;
        }
    }

    # Laravel API: every PHP request goes through public/index.php.
    location /api/ {
        set $api_upstream ${API_FASTCGI_UPSTREAM};
        include /etc/nginx/fastcgi_params;
        fastcgi_pass $api_upstream;
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_read_timeout 60s;
    }

    # Laravel build assets (production image only ships them).
    location ~ ^/(build|vendor)/ {
        try_files $uri =404;
    }

    # Everything else is the portal.
    location / {
        set $portal_upstream ${PORTAL_UPSTREAM};
        proxy_pass http://$portal_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }
}
