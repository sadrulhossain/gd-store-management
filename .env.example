# Copy to .env before running `docker compose up -d --build`.
# Values marked "change-me" or listed as examples are placeholders: replace them for anything
# but a throwaway dev machine. Production refuses to start with the placeholder database password.

# --- Application
APP_NAME="Store Management"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:38080
LOG_LEVEL=debug

# --- Database
DB_DATABASE=store
DB_USERNAME=store
DB_PASSWORD=change-me
DB_HOST=store-postgres
# Port PostgreSQL listens on inside the Docker network (not published to the host).
DB_PORT=5432
# Host side of the database port. Bind address 127.0.0.1 keeps it off the LAN.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_HOST_PORT=35432

# --- Containers
# Run Laravel migrations on start (only the store-api container ever does).
RUN_MIGRATIONS=true
# UID/GID of the in-container "app" user baked into the images (production).
APP_UID=1000
APP_GID=1000
PHP_FPM_MAX_CHILDREN=10
# Development bind-mount user. Docker Desktop (Windows/macOS) mounts ./api and ./portal as root,
# so dev containers run as 0:0 there. On Linux set your host uid:gid, e.g. 1000:1000.
# Production images always run as non-root.
DEV_USER=0:0

# --- Ports published on the host
GATEWAY_PORT=38080
PORTAL_PORT=33000
ADMINER_HOST_PORT=38081

# --- Service-to-service URLs inside the Docker network (container ports, not the host ports above)
API_INTERNAL_URL=http://store-nginx:8080/api/v1
GATEWAY_URL=http://store-nginx:8080

# --- Uploads: drives PHP upload_max_filesize, post_max_size and nginx client_max_body_size
UPLOAD_MAX_SIZE=5M

# --- Authentication
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
LOGIN_MAX_ATTEMPTS=5
LOGIN_DECAY_SECONDS=60
# Set to false only when testing the production stack over plain HTTP (cookies lose "Secure").
COOKIE_SECURE=true

# --- Seed data (php artisan db:seed)
SEED_ADMIN_NAME="Store Owner"
SEED_ADMIN_USERNAME=owner
SEED_ADMIN_EMAIL=owner@example.com
# Example value: replace it. Seeding in production refuses to run with this value.
SEED_ADMIN_PASSWORD=ChangeMe!2026
# Local environment only: password for the demo manager and employee accounts.
SEED_DEMO_PASSWORD=Demo!Pass2026

# --- Secrets generated for you in development, required in production
# Development: the entrypoint generates these into api/.env and storage/ (git-ignored) when unset.
# Production: set all of them. Never bake them into images or commit them.
#   APP_KEY                  docker compose run --rm --no-deps store-api php artisan key:generate --show
#   PASSPORT_PRIVATE_KEY     openssl genrsa 4096   (newlines as literal \n in this file)
#   PASSPORT_PUBLIC_KEY      openssl rsa -pubout   (same format)
#   PASSPORT_PORTAL_CLIENT_* php artisan store:passport-client  (prints both values)
# APP_KEY=
# PASSPORT_PRIVATE_KEY=
# PASSPORT_PUBLIC_KEY=
# PASSPORT_PORTAL_CLIENT_ID=
# PASSPORT_PORTAL_CLIENT_SECRET=
