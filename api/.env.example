# Laravel environment for running the API outside Docker.
# Under Docker Compose these values come from the repository-root .env instead.

APP_NAME="Store Management"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080

LOG_CHANNEL=stderr
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=store
DB_USERNAME=store
DB_PASSWORD=

SESSION_DRIVER=array
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=private
STORAGE_PUBLIC_URL=/storage
